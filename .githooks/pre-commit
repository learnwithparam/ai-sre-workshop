#!/bin/sh
# Rebuild the PDFs when a commit stages anything they are built from. The source list
# is the one `make book` records in scripts/pdf_freshness.json, so there is no second list to drift.
set -e
cd "$(git rev-parse --show-toplevel)"
hit=$(STAGED="$(git diff --cached --name-only)" python3 -c '
import json, os
staged = set(os.environ["STAGED"].split("\n"))
sources = {f for files in json.load(open("scripts/pdf_freshness.json")).values() for f in files}
print("\n".join(sorted(sources & staged)))
')
if [ -n "$hit" ]; then
	echo "pre-commit: PDF sources staged, running make book"
	make book
	git add ai-sre-workbook.pdf ai-sre-guide.pdf scripts/pdf_freshness.json
fi
