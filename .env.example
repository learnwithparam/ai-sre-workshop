# Copy to .env. Paste the first two yourself; `make env` generates everything else.

# HyperDX at http://localhost:8080 > Team Settings > Ingestion API Key
HYPERDX_API_KEY=change-me
# https://openrouter.ai/keys
OPENROUTER_API_KEY=change-me

# Generated by make env
CLICKHOUSE_READER_PASSWORD=change-me
CLICKHOUSE_WRITER_PASSWORD=change-me
CLICKHOUSE_MCP_AUTH_TOKEN=change-me
SRE_MCP_TOKEN=change-me
SRE_SESSION_SECRET=change-me
SRE_APPROVER_EMAIL=oncall@example.com
SRE_APPROVER_PASSWORD=change-me
LIBRECHAT_USER_EMAIL=sre@example.com
LIBRECHAT_USER_PASSWORD=change-me
HYPERDX_USER_EMAIL=workshop@example.com
HYPERDX_USER_PASSWORD=change-me
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CREDS_KEY=change-me
CREDS_IV=change-me

# VPS only: every UI is served as https://<name>.PUBLIC_DOMAIN (see caddy/Caddyfile)
PUBLIC_DOMAIN=workshop.example.com
